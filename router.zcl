// Zyanya DEX Multi-Hop Router Contract in Zyanya Contract Language (ZCL)
// Routes token swaps through multiple DEX liquidity pools sequentially in a single atomic call.

contract Router {
    // Entry point 0: Constructor / Initialization
    fn init() {
        return 0;
    }

    // Entry point 1: swap2Hop(caller_param, pool1, pool2, amountIn, minAmountOut)
    // Swaps amountIn on pool1, takes out1 and swaps on pool2.
    // F-C-04: Enforces caller verification and minAmountOut slippage protection.
    fn swap2Hop(caller_param, pool1, pool2, amountIn, minAmountOut) {
        let sender = caller();
        if (caller_param != sender) {
            return 0;
        }
        if (amountIn == 0) {
            return 0;
        }

        let out1 = call(pool1, 100000, amountIn);
        if (out1 == 0) {
            return 0;
        }

        let out2 = call(pool2, 100000, out1);
        if (out2 < minAmountOut) {
            return 0;
        }

        return out2;
    }

    // Entry point 2: swap3Hop(caller_param, pool1, pool2, pool3, amountIn, minAmountOut)
    // Swaps amountIn sequentially through pool1 -> pool2 -> pool3.
    // F-C-04: Enforces caller verification and minAmountOut slippage protection.
    fn swap3Hop(caller_param, pool1, pool2, pool3, amountIn, minAmountOut) {
        let sender = caller();
        if (caller_param != sender) {
            return 0;
        }
        if (amountIn == 0) {
            return 0;
        }

        let out1 = call(pool1, 100000, amountIn);
        if (out1 == 0) {
            return 0;
        }

        let out2 = call(pool2, 100000, out1);
        if (out2 == 0) {
            return 0;
        }

        let out3 = call(pool3, 100000, out2);
        if (out3 < minAmountOut) {
            return 0;
        }

        return out3;
    }
}
