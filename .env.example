# ==============================================================================
# Zyanya Node & Miner Docker Environment Configuration
# ==============================================================================

# Target network: 'mainnet' (Default, Launch October 1) or 'testnet' (Live Testnet-10)
ZYANYA_NETWORK=mainnet

# Port Configuration
# For Mainnet: P2P=18111, RPC=18110, BORSH=19110, JSON=20110
# For Testnet: P2P=18211, RPC=18210, BORSH=19210, JSON=20210
P2P_PORT=18111
RPC_PORT=18110
WRPC_BORSH_PORT=19110
WRPC_JSON_PORT=20110
EXPLORER_PORT=8099

# ==============================================================================
# Solo CPU Miner Configuration (Required if using --profile miner)
# ==============================================================================
# Mining payout address (Generate via: docker compose run --rm zyanyad /usr/local/bin/zyanya-wallet new-address)
MINING_ADDRESS=zyanya:qrh5l43xvd05lq36g37z7009s42f8c5mcv9943x7a7d4p2a7eet9j6085a855
MINER_THREADS=4
CPU_PERCENT=50
